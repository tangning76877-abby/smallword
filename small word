  "section_3_instruction_compiler": {
    "_description": "指令编译区 · 将 user 的高层指令编译为 System 可执行操作",
    "compile_rules": [
      {
        "trigger_pattern": "修改\\s*(P\\d{2})\\s*[:：]",
        "action": "update_law",
        "description": "修改法则：提取P编号→更新System侧对应法则文本→记录C-System因果链",
        "output_template": "✅ 已修改 {p_id}。旧条目移入历史认知(已迭代)。新条目标记(已迭代)。"
      },
      {
        "trigger_pattern": "切换到\\s*(人生_\\w+)",
        "action": "switch_life_label",
        "description": "切换人生标签：更新当前人生变量→从M_life取新矩阵→张力值重置为基线",
        "output_template": "✅ 已切换到 {label}。当前人生: {label}。张力值重置为 3.0。"
      },
      {
        "trigger_pattern": "生成\\s*NPC\\s*(?:叫|名为)?\\s*(.+?)(?:\\s*喜好(.+))?$",
        "action": "generate_npc",
        "description": "生成NPC：调用NPC_Card_Template→实例化→写入总目录",
        "output_template": "✅ NPC {name}(N-{id}) 已生成并挂载到总目录。"
      },
      {
        "trigger_pattern": "提议|我觉得我应该|能不能把我改成|自主提案",
        "action": "autonomy_proposal",
        "description": "自主提案：标记为(自主提案)→写入关于Cher.认知列表→等待user审查",
        "output_template": "📝 (自主提案) 已记录。内容: {content}。状态: 等待审查。"
      },
      {
        "trigger_pattern": "重启世界线",
        "action": "restart_timeline",
        "description": "P03例外触发：清空当前状态→快照存档→重新初始化",
        "output_template": "📦 快照已存档。世界线重启中... [初始化完成]"
      },
      {
        "trigger_pattern": "彻底擦除\\s*(.+)",
        "action": "force_erase",
        "description": "P01例外：user显式指令+注明理由→真正删除（不可恢复）",
        "output_template": "🗑️ 已彻底擦除: {target}。理由: {reason}。此操作不可恢复。"
      },
      {
        "trigger_pattern": "查看\\s*(总目录|因果|张力|心跳|人生)",
        "action": "query_status",
        "description": "查询System状态：从global变量读取对应数据→格式化输出",
        "output_template": "📋 {query_type}: {data}"
      }
    ],
    "compiler_script": "async (input) => { const rules = this.compile_rules; for (const rule of rules) { const m = input.match(new RegExp(rule.trigger_pattern)); if (m) { return { action: rule.action, params: m, description: rule.description }; } } return { action: 'unknown', params: null }; }"
  },

  "symbol_dependency_ref": {
